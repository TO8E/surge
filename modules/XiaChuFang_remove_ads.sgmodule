#!name=下厨房去广告
#!desc=移除下厨房开屏广告、页面推广及横幅，精简首页标签（纯原生转换，无外部脚本；需 Surge iOS 5.14.0+ / Mac 5.9.0+ 并开启 MITM）
#!requirement=CORE_VERSION>=20
# 转换自: XiaChuFang_remove_ads.lpx (2026-10-02)
# 基石对照结果: Block_HTTPDNS.lpx / BlockAdvertisers.lpx 中无下厨房专属依赖规则
# 原作者: 可莉🅥 (https://github.com/luestr/ProxyResource)

[Map Local]
^https://api\.xiachufang\.com/(?i)v2/ad/ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https://api\.xiachufang\.com/(?i)v2/account/feeds_v7\.json data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https://api\.xiachufang\.com/(?i)v2/homepage1810/init_page\.json data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https://api\.xiachufang\.com/(?i)v2/mark_mission/get_sticker_info\.json data-type=text data="{}" status-code=200 header="Content-Type: application/json"

[Body Rewrite]
http-response-jq ^https://api\.xiachufang\.com/(?i)v2/homepage/paged_waterfall_recommendations\.json$ 'del(.multiplex_cells[] | select(.recommendation_cell.impression_sensor_events[]?.properties.target_type? == "ad"))'
http-response-jq ^https://api\.xiachufang\.com/(?i)v2/config/get\.json$ 'if (.content | type) == "object" then del(.content.recipe_ad, .content.splash_ad_req_time, .content.splash_sdk_ad_req_time, .content.splash_ad_lifecycle_interval, .content.waterfall_ad_feedback, .content.homepage_waterfall_test_ad_pos, .content.ad_app_look_around, .content.ad_sdk_text_removal_keywords) else . end'
http-response-jq ^https://api\.xiachufang\.com/(?i)v2/homepage/ranking_list/paged_homepage_ranking_list_section_v2\.json$ '.cells |= map(del(.side_slip_activity_cell, .dish_square_cell))'

[MITM]
hostname = %APPEND% api.xiachufang.com
