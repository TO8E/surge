#!name=中国联通去广告
#!desc=过滤中国联通开屏、搜索、浮窗及部分页面推广（纯原生规则与 JQ 重写，无外部脚本；需 Surge iOS 5.14.0+ / Mac 5.9.0+ 并开启 MITM）
#!requirement=CORE_VERSION>=20
# 转换自: ChinaUnicom.lpx (2026-11-10)，不合并基石插件
# 原作者: mist-whisper (https://github.com/mist-whisper)

[Rule]
# > 开屏广告
DOMAIN,m1.ad.10010.com,REJECT,pre-matching

[Map Local]
# > 广告推送、新人专享、首页瀑布流
^https?://m\.client\.10010\.com/(?i)mobileserviceimportant/customer/querySmartServicekhd\.htm data-type=text data="" status-code=404
^https?://m\.client\.10010\.com/(?i)clientIndex/api/v1/index/queryIndexExclusiveOffers data-type=text data="" status-code=404
^https?://img\.client\.10010\.com/(?i)homejingxuan12/js/(pubuliu|1homeView) data-type=text data="" status-code=404

[Body Rewrite]
# > 搜索框推广
http-response-jq ^https://m\.client\.10010\.com/(?i)search_service/tyfbSearch/searchDiscoverListExpress '.data = []'
http-response-jq ^https://m\.client\.10010\.com/(?i)search_service/search/searchScrollWord '.["113000004"] = []'

# > 浮窗推广
http-response-jq ^https://m\.client\.10010\.com/(?i)clientIndex/v1/api/navHome '.datas.homeTopMenuItems |= map(select(.menuName != "通通" and .menuName != "vowifi" and .menuName != "签到" and .menuName != ""))'
http-response-jq ^https://m\.client\.10010\.com/(?i)clientIndex/homefusion/fuInter 'del(.["HomeFusion.backGroundQuery"], .["HomeFusion.fuchuangAdv_A8"], .["HomeFusion.bottomLabel"])'

# > 我的页面钱包及借钱/积分/彩铃/横幅/本地图片推广
http-response-jq ^https://m\.client\.10010\.com/(?i)clientMyPage/v1/api/myWallet '.data = {}'
http-response-jq ^https://m\.client\.10010\.com/(?i)clientMyPage/v\d/api/(myWallet|myPoints|myColorfulRingtone|newUserInfo|getDeviceInfo) '.data = {}'

[MITM]
hostname = %APPEND% m.client.10010.com, img.client.10010.com
