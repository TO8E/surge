#!name=彩云天气Pro
#!desc=去广告 + 解锁 SVIP（需开启 MITM）
#!requirement=CORE_VERSION>=20
# 原作者: RuCu6 (https://github.com/RuCu6/Loon) / 树先生 (https://github.com/ishowshu/qx)
# 会员解锁走响应体改写（vip_info / user_detail / v2/user），不依赖会员 token

[Rule]
DOMAIN,abyss.cyapi.cn,REJECT,pre-matching
DOMAIN,ad.cyapi.cn,REJECT,pre-matching
DOMAIN,gather.colorfulclouds.net,REJECT,pre-matching

[Map Local]
^https://biz\.cyapi\.cn/(p/v1/entries|p/v1/trial_card/info|v2/product) data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https://starplucker\.cyapi\.cn/v3/operation/features data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https://starplucker\.cyapi\.cn/v3/(config/cypage/\w+/conditions|notification/message_center|operation/homefeatures) data-type=text data="{}" status-code=200 header="Content-Type: application/json"

[Script]
# 会员凭证注入：必须是 http-request 阶段——脚本以 $response 未定义判断走 device-token 替换分支
彩云天气卫星云图 = type=http-request,pattern=^https://wrapper\.cyapi\.cn/v1/(nafp/origin_images|satellite)\?,script-path=https://raw.githubusercontent.com/TO8E/surge/main/scripts/caiyun.js,engine=jsc
# 会员状态：响应体改写为永久 SVIP（核心解锁，不依赖 token）
彩云天气会员信息 = type=http-response,pattern=^https://biz\.cyapi\.cn/(api/v1/user_detail|p/v1/vip_info|v2/user),script-path=https://raw.githubusercontent.com/TO8E/surge/main/scripts/caiyun.js,requires-body=true,engine=jsc
# 活动推广清洗
彩云天气活动推广 = type=http-response,pattern=^https://api\.caiyunapp\.com/v1/activity\?,script-path=https://raw.githubusercontent.com/TO8E/surge/main/scripts/caiyun.js,requires-body=true,engine=jsc
彩云天气推广信息 = type=http-response,pattern=^https://wrapper\.cyapi\.cn/v1/activity\?,script-path=https://raw.githubusercontent.com/TO8E/surge/main/scripts/caiyun.js,requires-body=true,engine=jsc

[MITM]
hostname = %APPEND% wrapper.cyapi.cn, api.caiyunapp.com, starplucker.cyapi.cn, biz.cyapi.cn
