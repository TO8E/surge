#!name=京东
#!desc=过滤京东广告（仅支持京东标准模式，纯原生转换，不合入基石；需 Surge iOS 5.14.0+ / Mac 5.9.0+ 并开启 MITM）
#!requirement=CORE_VERSION>=20
# 转换自: JingDong.lpx (2026-11-02)，不合并基石插件，已移除慢慢买历史比价相关规则与脚本
# 原作者: RuCu6 (https://github.com/RuCu6), Maasea (https://github.com/Maasea), 可莉🅥 (https://github.com/luestr/ProxyResource)

[Rule]
# AND,((DOMAIN,api.m.jd.com),(PROTOCOL,TCP)),REJECT-NO-DROP
URL-REGEX,^http://\w{32}\.jddebug\.com/diagnose\?,REJECT

[Map Local]
^https?://m\.360buyimg\.com/(?i)mobilecms/s1125x2436_jfs data-type=text data="" status-code=200
^https?://api\.m\.jd\.com/(?i)\?loginType=11 data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https?://api\.m\.jd\.com/(?i)client\.action\?functionId=getWidgetV1052 data-type=text data="" status-code=404
^https://api\.m\.jd\.com/(?i)client\.action\?functionId=(?:cartCouponRecommendGoods|intelligentRecommendSku|obtainGrowingInfo|recommendShop|searchBoxWord|stationPullService|uniformRecommend) data-type=text data="{}" status-code=200 header="Content-Type: application/json"

[Body Rewrite]
# > 京东极速版广告（原生 Body Rewrite，替代原插件中重复的 replace-body.js 脚本）
http-response ^https?://api\.m\.jd\.com/(?i)client\.action\?functionId=lite_advertising jdLiteAdvertisingVO sooyaaabo
# > 关闭京东内置 HTTPDNS 与 Socket 监控上报
http-response-jq ^https://api\.m\.jd\.com/(?i)client\.action\?functionId=basicConfig 'if .data.JDMessage.socketmonitor? then .data.JDMessage.socketmonitor.isSocketEstablishedAhead = 0 | .data.JDMessage.socketmonitor.isSocketReport = 0 else . end | if .data.JDHttpToolKit.httpdns? then .data.JDHttpToolKit.httpdns.httpdns = 0 else . end'
# > 移除空购物车推荐楼层
http-response-jq ^https://api\.m\.jd\.com/(?i)client\.action\?functionId=cart 'if (.cartLocationMap | type) == "object" then del(.cartLocationMap.loc_emptyCartFloor2) else . end | del(.emptyCartRecommendFloor)'

[Script]
# > 京东移除广告
京东移除广告 = type=http-response,pattern=^https://api\.m\.jd\.com/(?i)client\.action\?functionId=(?:deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome),script-path=https://rucu6.pages.dev/Scripts/jingdong.js,requires-body=true

[MITM]
hostname = %APPEND% api.m.jd.com, m.360buyimg.com
