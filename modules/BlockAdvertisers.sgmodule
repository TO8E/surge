#!name=广告平台拦截器
#!desc=拦截主流广告平台与第三方 SDK 广告请求（腾讯优量汇、穿山甲、快手、百度、阿里、友盟、极光、个推、Google、AppLovin、Unity3D 等）
#!requirement=CORE_VERSION>=20
# 转换自: BlockAdvertisers.lpx (2026-10-02)
# 原作者: 可莉🅥 (https://github.com/luestr/ProxyResource)

[Rule]
# > 广告平台域名与逻辑规则 (保留字节跳动 tnc、Mob 短信、极光认证的 DIRECT 放行顺序)
DOMAIN-KEYWORD,adstrategy,REJECT,pre-matching
AND,((DOMAIN-KEYWORD,tnc),(OR,((DOMAIN-SUFFIX,capcutapi.com),(DOMAIN-SUFFIX,zijieapi.com),(DOMAIN-SUFFIX,isnssdk.com),(DOMAIN-SUFFIX,toutiaoapi.com),(DOMAIN-SUFFIX,bytedance.com),(DOMAIN-SUFFIX,snssdk.com),(DOMAIN-SUFFIX,sgsnssdk.com)))),DIRECT
AND,((DOMAIN-KEYWORD,-ad-),(DOMAIN-SUFFIX,byteimg.com)),REJECT,pre-matching
AND,((DOMAIN-KEYWORD,ads),(DOMAIN-KEYWORD,-normal.zijieapi.com)),REJECT
