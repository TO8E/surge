# > 广告平台 IP 规则
IP-CIDR,47.110.187.87/32,REJECT,no-resolve,pre-matching

[Map Local]
^https://video-dsp\.pddpic\.com/(?i)market-dsp-video/ data-type=text data="" status-code=404
^https://t-dsp\.pinduoduo\.com/(?i)dspcb/i/mrk_ data-type=text data="" status-code=404
^https://images\.pinduoduo\.com/(?i)mrk/ data-type=text data="" status-code=404
^https://images\.pinduoduo\.com/(?i)marketing_api/ data-type=text data="" status-code=404

[MITM]
hostname = %APPEND% video-dsp.pddpic.com, t-dsp.pinduoduo.com, images.pinduoduo.com
