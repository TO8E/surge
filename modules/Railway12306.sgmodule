#!name=铁路12306
#!desc=过滤铁路 12306 开屏与应用内广告（纯原生转换，不合入基石；需开启 MITM）
# 转换自: Railway12306.lpx (2026-11-02)，不合并基石插件
# 原作者: RuCu6 (https://github.com/RuCu6), kokoryh (https://github.com/kokoryh)

[Rule]
# > 放行规则（避免被其他规则直接拦截导致开屏超时，交由 MITM 脚本快速跳过）
DOMAIN,ad.12306.cn,DIRECT

[Script]
# > 脚本使用 WebAPI new URL()，按 Surge 规范显式指定 engine=webview
铁路12306开屏广告 = type=http-request,pattern=^https://ad\.12306\.cn/(?i)ad/ser/getAdList$,script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/master/dist/12306.js,requires-body=true,engine=webview
铁路12306应用内广告 = type=http-request,pattern=^https://mobile\.12306\.cn/(?i)otsmobile/app/mgs/mgw\.htm$,script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/master/dist/12306.js,requires-body=false,engine=webview

[MITM]
hostname = %APPEND% ad.12306.cn, mobile.12306.cn
