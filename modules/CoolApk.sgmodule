#!name=酷安去广告
#!desc=过滤酷安开屏、信息流、评论区与热搜广告，重定向酷安外链；已拆分内置酷安常用广告联盟与 HTTPDNS 依赖规则，可单独启用（需 Surge iOS 5.14.0+ / Mac 5.9.0+ 并开启 MITM）
#!requirement=CORE_VERSION>=20
# 转换自: CoolApk.lpx (2026-11-02)
# 拆分公共依赖来源: Block_HTTPDNS.lpx, BlockAdvertisers.lpx
# 原作者: RuCu6 (https://github.com/RuCu6), ZenmoFeiShi (https://github.com/ZenmoFeiShi), VenenoSix24 (https://github.com/VenenoSix24), 可莉🅥 (https://github.com/luestr/ProxyResource), VirgilClyne (https://github.com/VirgilClyne)

[Rule]
# > 公共依赖: 穿山甲 / 字节跳动广告 SDK (来源: BlockAdvertisers.lpx，保留 tnc DIRECT 放行顺序)
DOMAIN-KEYWORD,adstrategy,REJECT,pre-matching
AND,((DOMAIN-KEYWORD,tnc),(OR,((DOMAIN-SUFFIX,capcutapi.com),(DOMAIN-SUFFIX,zijieapi.com),(DOMAIN-SUFFIX,isnssdk.com),(DOMAIN-SUFFIX,toutiaoapi.com),(DOMAIN-SUFFIX,bytedance.com),(DOMAIN-SUFFIX,snssdk.com),(DOMAIN-SUFFIX,sgsnssdk.com)))),DIRECT
AND,((DOMAIN-KEYWORD,-ad-),(DOMAIN-SUFFIX,byteimg.com)),REJECT,pre-matching
AND,((DOMAIN-KEYWORD,ads),(DOMAIN-KEYWORD,-normal.zijieapi.com)),REJECT
DOMAIN,lf-ad-ies.bytecdn.cn,REJECT,pre-matching
DOMAIN,dig.bdurl.net,REJECT,pre-matching
DOMAIN,extlog.snssdk.com,REJECT,pre-matching
DOMAIN,mcs.snssdk.com,REJECT,pre-matching
DOMAIN-SUFFIX,bds.snssdk.com,REJECT,pre-matching
DOMAIN-SUFFIX,byteadverts.com,REJECT,pre-matching
DOMAIN-SUFFIX,ctobsnssdk.com,REJECT,pre-matching
DOMAIN-SUFFIX,pangle.io,REJECT,pre-matching
DOMAIN-KEYWORD,pangolin,REJECT,pre-matching
DOMAIN-KEYWORD,pglstatp,REJECT,pre-matching
DOMAIN-KEYWORD,panplayable-toutiao,REJECT,pre-matching
DOMAIN-KEYWORD,-ad-sign.byteimg.com,REJECT,pre-matching
DOMAIN-KEYWORD,-ad.byteoversea.com,REJECT,pre-matching
DOMAIN-KEYWORD,asiad.byteactivity,REJECT,pre-matching

# > 公共依赖: 腾讯优量汇 / 广点通广告 SDK (来源: BlockAdvertisers.lpx)
DOMAIN,tdid.m.qq.com,REJECT,pre-matching
DOMAIN,ads.privacy.qq.com,REJECT,pre-matching
DOMAIN,pgdt.gtimg.cn,REJECT,pre-matching
DOMAIN,qzs.qq.com,REJECT,pre-matching
DOMAIN,h.trace.qq.com,REJECT,pre-matching
DOMAIN,sdk.e.qq.com,REJECT,pre-matching
DOMAIN,tangram.e.qq.com,REJECT,pre-matching
DOMAIN-KEYWORD,trace.qq.com,REJECT,pre-matching
DOMAIN-SUFFIX,gdt.qq.com,REJECT,pre-matching
DOMAIN-SUFFIX,l.qq.com,REJECT,pre-matching
DOMAIN-SUFFIX,gdtimg.com,REJECT,pre-matching
DOMAIN-SUFFIX,ugdtimg.com,REJECT,pre-matching

# > 公共依赖: 快手联盟广告 SDK (来源: BlockAdvertisers.lpx)
DOMAIN,gdfp.gifshow.com,REJECT,pre-matching
DOMAIN,open.e.kuaishou.com,REJECT,pre-matching
DOMAIN,open.e.kuaishou.cn,REJECT,pre-matching
DOMAIN,adtrack.e.kuaishou.com,REJECT,pre-matching
DOMAIN-SUFFIX,partner.gifshow.com,REJECT,pre-matching
DOMAIN-SUFFIX,adukwai.com,REJECT,pre-matching
DOMAIN-SUFFIX,adkwai.com,REJECT,pre-matching

# > 公共依赖: 百度百青藤广告 SDK (来源: BlockAdvertisers.lpx)
DOMAIN,afd.baidu.com,REJECT,pre-matching
DOMAIN,als.baidu.com,REJECT,pre-matching
